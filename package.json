{
  "name": "han-type",
  "scripts": {
    "format": "prettier --write .",
    "prepare": "husky",
    "type-check": "pnpm --filter \"./{packages,apps}/**\" type-check",
    "start:web": "pnpm --filter web dev",
    "build": "rm -rf packages/*/dist && rollup -c --bundleConfigAsCjs",
    "build:watch": "pnpm build --watch"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^11.1.6",
    "@swc/core": "^1.16.20",
    "@types/eslint": "^8.56.12",
    "@types/node": "20.5.8",
    "eslint": "8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "rollup": "^3.30.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-styles": "^4.0.0",
    "rollup-plugin-swc3": "^0.10.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "decode-uri-component": "^0.5.0",
      "minimatch@^9.0.0": "^9.0.7"
    }
  }
}
